        if not sbRuntime.SkillBusy and (now - sbRuntime.SkillTick) >= SpookyBounty.SkillDelay then
            sbRuntime.SkillTick = now
            sbRuntime.SkillBusy = true
            local kc = SB_SKILL_KEYS[sbRuntime.SkillIdx]
