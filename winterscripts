local function setActiveTab(tabName)
    HomePage.Visible = (tabName == "Home")
    CombatPage.Visible = (tabName == "Combat")
    GlitchesPage.Visible = (tabName == "Glitches")
    ESPPage.Visible = (tabName == "ESP")
    SBPage.Visible = (tabName == "Bounty")

    local function setBtnState(btn, stroke, active)
        if active then
            btn.BackgroundColor3 = THEME
            btn.BackgroundTransparency = 0.1
            btn.TextColor3 = Color3.new(1,1,1)
            stroke.Color = THEME_LIGHT
            stroke.Thickness = 1.5
        else
            btn.BackgroundColor3 = BG.Panel
            btn.BackgroundTransparency = 0.3
            btn.TextColor3 = BG.TextDim
            stroke.Color = BG.Border
            stroke.Thickness = 1
        end
    end

    setBtnState(homeTabBtn, homeTabStroke, tabName == "Home")
    setBtnState(combatTabBtn, combatTabStroke, tabName == "Combat")
    setBtnState(glitchesTabBtn, glitchesTabStroke, tabName == "Glitches")
    setBtnState(espTabBtn, espTabStroke, tabName == "ESP")
    setBtnState(sbTabBtn, sbTabStroke, tabName == "Bounty")
end

