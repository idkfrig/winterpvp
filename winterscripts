    partTele:GetPropertyChangedSignal("CFrame"):Connect(function()
        local c = player.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            c.HumanoidRootPart.CFrame = partTele.CFrame
            c.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        end
    end)
    local dist = (targetPos - hrp.Position).Magnitude
    local t = math.max(dist / SpookyBounty.Speed, 0.1)
    sbRuntime.Tween = TweenService:Create(partTele, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
