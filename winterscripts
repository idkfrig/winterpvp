local function espTeamInfo(targetP)
    if not targetP or not targetP.Team then return "Unknown", Color3.fromRGB(255,255,255) end
    if targetP.Team.Name == "Marines" then return "Marines", Color3.fromRGB(0,170,255)
    else return "Pirates", Color3.fromRGB(255,70,70) end
end
local function espHexToColor3(hex)
    local r = tonumber(hex:sub(1,2), 16) / 255 or 0
    local g = tonumber(hex:sub(3,4), 16) / 255 or 1
    local b = tonumber(hex:sub(5,6), 16) / 255 or 0
    return Color3.new(r, g, b)
end
local function espRemove(targetP)
    if espObjects[targetP] then
        pcall(function()
            if espObjects[targetP].gui then espObjects[targetP].gui:Destroy() end
            if espObjects[targetP].highlight then espObjects[targetP].highlight:Destroy() end
        end)
        espObjects[targetP] = nil
    end
end
local function espCreate(targetP)
    if not targetP or targetP == player then return end
    local char = targetP.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local team, color = espTeamInfo(targetP)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "WinterESP_Billboard"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 75)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextScaled = false
    text.TextSize = ESP.TextSize or 12
    text.RichText = true
    text.Font = Enum.Font.Arcade
    text.TextStrokeTransparency = 0
    text.TextColor3 = color
    text.Parent = billboard
    local highlight = nil
    if ESP.Highlight then
        local hlColor = espHexToColor3(ESP.HighlightColor or "FF0000")
        highlight = Instance.new("Highlight")
        highlight.Name = "ESP_PlayerHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = hlColor
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = hlColor
        highlight.OutlineTransparency = 0
        highlight.Parent = char
    end
    espObjects[targetP] = { gui = billboard, label = text, char = char, highlight = highlight }
end
local function espPlayerData(targetP)
    if not espPlayerCache[targetP] then
        espPlayerCache[targetP] = { level="?", fruit="None", bounty=0, team="Unknown", color=Color3.fromRGB(255,255,255), lastUpdate=0 }
    end
    local data = espPlayerCache[targetP]
    local now = tick()
    if now - data.lastUpdate > 5 then
        pcall(function() data.level = targetP.Data.Level.Value end)
        pcall(function() data.fruit = targetP.Data.DevilFruit.Value end)
        pcall(function() data.bounty = targetP.leaderstats["Bounty/Honor"].Value end)
        data.team, data.color = espTeamInfo(targetP)
        data.lastUpdate = now
    end
    return data
end
local function espUpdate()
    if not ESP.Enabled then return end
    local anySubActive = ESP.Name or ESP.Level or ESP.Bounty or ESP.Fruit or ESP.Distance or ESP.HP or ESP.Highlight
    if not anySubActive then return end
    local now = tick()
    if now - lastESPUpdate < (ESP.UpdateInterval or 0.1) then return end
    lastESPUpdate = now
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    for _, targetP in ipairs(Players:GetPlayers()) do
        if targetP ~= player then
            local char = targetP.Character
            local head = char and char:FindFirstChild("Head")
            local data = espObjects[targetP]
            if char and head then
                if not data or data.char ~= char or not data.gui.Parent then
                    espRemove(targetP); espCreate(targetP); data = espObjects[targetP]
                end
                if data then
                    local hum = char:FindFirstChild("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if hum and root then
                        local distance = math.floor((root.Position - myPos).Magnitude)
                        local hp = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)
                        local pData = espPlayerData(targetP)
                        data.label.TextColor3 = pData.color
                        if data.label.TextSize ~= ESP.TextSize then data.label.TextSize = ESP.TextSize or 12 end
                        local parts = {}
                        if ESP.Name then parts[#parts+1] = "[" .. pData.team .. "] <font color=\"rgb(255,255,0)\">" .. targetP.Name .. "</font>" end
                        if ESP.Level then parts[#parts+1] = " [Lv." .. pData.level .. "]" end
                        if ESP.Bounty then
                            local bM = type(pData.bounty) == "number" and math.floor(pData.bounty / 1000000) or 0
                            parts[#parts+1] = "\nBounty: " .. bM .. "M\n"
                        end
                        if ESP.Fruit then parts[#parts+1] = "Fruit: " .. tostring(pData.fruit) .. "\n" end
                        if ESP.Distance then parts[#parts+1] = distance .. "m | " end
                        if ESP.HP then parts[#parts+1] = "HP " .. hp .. "%" end
                        data.label.Text = table.concat(parts)
                    end
                end
            else
                if data then espRemove(targetP) end
            end
        end
    end
end
local function espEnable()
    if espRunning then return end
    espRunning = true
    for _, targetP in ipairs(Players:GetPlayers()) do espCreate(targetP) end
    task.spawn(function()
        while espRunning do pcall(espUpdate); task.wait(ESP.UpdateInterval or 0.1) end
    end)
end
local function espDisable()
    espRunning = false
    for targetP, _ in pairs(espObjects) do espRemove(targetP) end
    espObjects = {}
end
ESP.Enable = espEnable
ESP.Disable = espDisable
ESP.Update = espUpdate

local function isAttackAnim(track)
    local kws = {"attack","slash","punch","m1","combo","hit","tool","ability","skill","gun","sword","melee","fruit"}
    local n = string.lower(track.Name)
    for _, kw in ipairs(kws) do if string.find(n, kw) then return true end end
    if track.Priority == Enum.AnimationPriority.Action then return true end
    return false
end
local function dropFPSManual(duration)
    local stop = tick() + (duration or 0.43)
    local interval = 1 / 20
    local con
    con = RunService.RenderStepped:Connect(function()
        if tick() > stop then if con then con:Disconnect() end; return end
        local now = tick()
        while tick() - now < interval do end
    end)
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dir = camera.CFrame.LookVector
            local att = Instance.new("Attachment"); att.Parent = hrp
            local lv = Instance.new("LinearVelocity")
            lv.MaxForce = math.huge
            lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
            lv.VectorVelocity = dir * 400
            lv.Attachment0 = att; lv.Parent = hrp
            task.delay(0.9, function()
                if lv and lv.Parent then lv:Destroy() end
                if att and att.Parent then att:Destroy() end
            end)
        end
    end
end
local function doSuperJumpGlitch()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local animator = hum:FindFirstChild("Animator")
    if animator then
        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
            if not isAttackAnim(track) then track:Stop(0) end
        end
    end
    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, Glitches.SuperJumpPower, hrp.AssemblyLinearVelocity.Z)
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
end
local function startSanguineAutoWatcher()
    if glitchRuntime.SanguineAutoConn then glitchRuntime.SanguineAutoConn:Disconnect(); glitchRuntime.SanguineAutoConn = nil end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    glitchRuntime.SanguineAutoConn = hum.AnimationPlayed:Connect(function(animTrack)
        if not Glitches.SanguineAuto or glitchRuntime.SanguineAutoCooldown then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        local tn = string.lower(tool.Name)
        if not (string.find(tn, "sanguine") or string.find(tn, "art")) then return end
        local id = tostring(animTrack.Animation and animTrack.Animation.AnimationId or "")
        if id:find("14586872029") or id:find("14418367908") or id:find("14418370048") then
            glitchRuntime.SanguineAutoCooldown = true
            dropFPSManual(Glitches.SanguineAutoDropDuration)
            task.delay(Glitches.SanguineAutoDropDuration + 0.5, function() glitchRuntime.SanguineAutoCooldown = false end)
        end
    end)
end
local function startNoAnimLoop()
    if glitchRuntime.NoAnimConn then glitchRuntime.NoAnimConn:Disconnect() end
    glitchRuntime.NoAnimConn = RunService.Stepped:Connect(function()
        if not Glitches.NoAnimations then return end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        hum.AutoRotate = true
        local animator = hum:FindFirstChild("Animator")
        if not animator then return end
        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
            if not isAttackAnim(track) then track:Stop(0) end
        end
    end)
end
local function startAntiLava()
    if glitchRuntime.AntiLavaConn then glitchRuntime.AntiLavaConn:Disconnect() end
    glitchRuntime.AntiLavaActive = true
    local timer = 0
    glitchRuntime.AntiLavaConn = RunService.Stepped:Connect(function(_, dt)
        timer = timer + dt
        if timer < 0.2 then return end
        timer = 0
        local char = player.Character
        if not (char and glitchRuntime.AntiLavaActive) then return end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "Torso"
            and part.Name ~= "UpperTorso" and part.Name ~= "LowerTorso" and part.Name ~= "Head" then
                part.CanTouch = false
            end
        end
    end)
end
local function stopAntiLava()
    glitchRuntime.AntiLavaActive = false
    if glitchRuntime.AntiLavaConn then glitchRuntime.AntiLavaConn:Disconnect(); glitchRuntime.AntiLavaConn = nil end
end
local function startDeleteShipLoop()
    if glitchRuntime.DeleteShipRunning then return end
    glitchRuntime.DeleteShipRunning = true
    glitchRuntime.DeleteShipActive = true
    task.spawn(function()
        while glitchRuntime.DeleteShipActive do
            task.spawn(function()
                local shipNames = {"CursedShip","Cursed Ship","Ship"}
                local exteriorNames = {"Wall","Floor","Ceiling","Base","Hull","Window","DoorFrame"}
                for _, obj in pairs(workspace:GetDescendants()) do
                    for _, sName in pairs(shipNames) do
                        if obj.Name:find(sName) and (obj:IsA("Model") or obj:IsA("Folder")) then
                            for _, child in pairs(obj:GetDescendants()) do
                                if child:IsA("BasePart") and not child.Parent:FindFirstChild("Humanoid") then
                                    local isExt = false
                                    for _, ext in pairs(exteriorNames) do
                                        if child.Name:find(ext) then isExt = true; break end
                                    end
                                    if not isExt then child:Destroy() end
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(3)
        end
        glitchRuntime.DeleteShipRunning = false
    end)
end

local PVP_STYLES = {
    "godhuman","superhuman","dragon","death step","electric","dark step",
    "water kung fu","sharkman","electric claw","ice","fire","light","magma",
    "sand","smoke","string","rumble","phoenix","buddha","love","paw","gravity","dough",
