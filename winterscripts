local function camLockStep(dt)
    if not SpookyAim.CamLockEnabled then return end
    if not Runtime.CamLockTarget then
        local _, m = selectPlayer(SpookyAim.CamLockRange)
        Runtime.CamLockTarget = m
        if not Runtime.CamLockTarget then return end
    end
    local char = Runtime.CamLockTarget
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then
        local _, m = selectPlayer(SpookyAim.CamLockRange)
        Runtime.CamLockTarget = m
        return
    end
    local camPos = camera.CFrame.Position
    local aimPos = hrp.Position + Vector3.new(0, 0.5, 0)
    local vel = hrp.AssemblyLinearVelocity or Vector3.zero
    if vel.Magnitude > 2 and vel.Magnitude < 450 then
        aimPos = aimPos + vel * math.clamp(SpookyAim.CamLockPrediction, 0, 0.15)
    end
    if (aimPos - camPos).Magnitude > SpookyAim.CamLockRange then Runtime.CamLockTarget = nil; return end
    local smooth = 0.32
    if SpookyAim.CamLockSmoothness == "Instant" then smooth = 1.0
    elseif SpookyAim.CamLockSmoothness == "Very Smooth" then smooth = 0.18 end
    local tCF = CFrame.lookAt(camPos, aimPos)
    local alpha = 1 - (1 - math.clamp(smooth, 0.05, 1)) ^ (math.clamp(dt or 1/60, 0, 0.1) * 60)
    camera.CFrame = camera.CFrame:Lerp(tCF, alpha)
end
