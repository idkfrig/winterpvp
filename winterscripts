local function refreshTargetList()
    for _, child in ipairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local autoBtn = Instance.new("TextButton", playerListFrame)
    autoBtn.Size = UDim2.new(1, -4, 0, 28)
    autoBtn.BackgroundColor3 = (pvpManualTarget == nil) and Color3.fromRGB(48, 22, 30) or BG.Row
    autoBtn.BackgroundTransparency = 0.1
    autoBtn.Font = Enum.Font.Arcade
    autoBtn.Text = "  Auto (furthest enemy)"
    autoBtn.TextSize = 10
    autoBtn.TextColor3 = (pvpManualTarget == nil) and THEME or BG.Text
    autoBtn.TextXAlignment = Enum.TextXAlignment.Left
    autoBtn.BorderSizePixel = 0
    autoBtn.ZIndex = 8
    autoBtn.Active = true
    Instance.new("UICorner", autoBtn).CornerRadius = UDim.new(0, 6)
    local autoStroke = Instance.new("UIStroke", autoBtn)
    autoStroke.Color = (pvpManualTarget == nil) and THEME or BG.Border
    autoStroke.Thickness = 1
    autoBtn.MouseButton1Click:Connect(function()
        pvpManualTarget = nil
        pvpFlyTarget = nil
        currentTargetLbl.Text = "  Target: Auto (furthest)"
        currentTargetLbl.TextColor3 = BG.TextDim
        refreshTargetList()
    end)

    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local c = p.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local dist = (h and myPos) and math.floor((h.Position - myPos).Magnitude) or 9999
            local alive = hum and hum.Health > 0
            table.insert(list, { p=p, d=dist, alive=alive })
        end
    end
    table.sort(list, function(a, b)
        if a.alive ~= b.alive then return a.alive end
        return a.d < b.d
    end)

    for _, info in ipairs(list) do
        local p = info.p
        local btn = Instance.new("TextButton", playerListFrame)
        btn.Size = UDim2.new(1, -4, 0, 28)
        btn.BackgroundColor3 = (pvpManualTarget == p) and Color3.fromRGB(48, 22, 30) or BG.Row
        btn.BackgroundTransparency = 0.1
        btn.Font = Enum.Font.Arcade
        btn.Text = string.format("  %s  %s  ·  %dst",
            info.alive and "●" or "○",
            p.DisplayName or p.Name,
            info.d
        )
        btn.TextSize = 9
        btn.TextColor3 = info.alive and ((pvpManualTarget == p) and THEME or BG.Text) or BG.TextDim
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.BorderSizePixel = 0
        btn.ZIndex = 8
        btn.Active = true
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        local s = Instance.new("UIStroke", btn)
        s.Color = (pvpManualTarget == p) and THEME or BG.Border
        s.Thickness = 1
        btn.MouseButton1Click:Connect(function()
            pvpManualTarget = p
            pvpFlyTarget = p
            currentTargetLbl.Text = "  Locked: " .. (p.DisplayName or p.Name)
            currentTargetLbl.TextColor3 = THEME
            refreshTargetList()
        end)
    end
end

