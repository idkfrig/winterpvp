local function isValid(p, maxDist)
    if not p or p == player or not p.Character then return false end
    if isBlacklisted(p) then return false end
    if SpookyAim.IgnoreLowLevel then
        local lvl = getLevel(p)
        if lvl > 0 and lvl < SpookyAim.MinLevel then return false end
    end
    local char = p.Character
    if not char:IsDescendantOf(workspace) then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hum or hum.Health <= 0 or not hrp then return false end
    if SpookyAim.SafeZoneCheck then
        if inSafeZone(p) or not isPvPOn(p) then return false end
    end
    if SpookyAim.TeamCheck and not isEnemy(p) then return false end
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    local dist = (hrp.Position - myHrp.Position).Magnitude
    if dist > (maxDist or SpookyAim.MaxDist) then return false end
    return true, dist, char
end
local function aimCenter()
    if SpookyAim.FovOrigin == "Mouse" and not UserInputService.TouchEnabled then
        local mp = UserInputService:GetMouseLocation()
        if mp.X > 0 and mp.Y > 0 then return mp end
    end
    return camera.ViewportSize / 2
end
local function aimScore(part, dist)
    if not part then return nil end
    if SpookyAim.AimMode == "360" then return dist end
    if SpookyAim.AimMode == "180" then
        local delta = part.Position - camera.CFrame.Position
        if delta:Dot(camera.CFrame.LookVector) < 0 then return nil end
        return dist
    end
    local pt, vis = camera:WorldToViewportPoint(part.Position)
    if not vis or pt.Z <= 0 then return nil end
    local r = math.clamp(SpookyAim.FovRadius, 20, 800)
    local px = (Vector2.new(pt.X, pt.Y) - aimCenter()).Magnitude
    return px <= r and px or nil
end
local function selectPlayer(maxDist, exclude)
    local best, bestScore, bestModel = nil, math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p ~= exclude then
            local ok, valid, dist, model = pcall(isValid, p, maxDist or SpookyAim.MaxDist)
            if ok and valid then
                if SpookyAim.TargetPolicy == "Selected" and tostring(p.UserId) ~= tostring(SpookyAim.TargetUserId) then valid = false end
                if valid then
                    local part = model:FindFirstChild(SpookyAim.TargetPart) or model:FindFirstChild("HumanoidRootPart")
                    local score = aimScore(part, dist)
                    if score and score < bestScore then best, bestScore, bestModel = p, score, model end
                end
            end
        end
    end
    return best, bestModel
end
local function getClosestNPC(maxDist)
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local closest, best = nil, maxDist or SpookyAim.MaxDist
    local myPos = myHrp.Position
    local function scan(f)
        if not f then return end
        for _, npc in ipairs(f:GetChildren()) do
            if npc:IsDescendantOf(workspace) and not Players:GetPlayerFromCharacter(npc) then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                if hum and hum.Health > 0 and hrp then
                    local d = (hrp.Position - myPos).Magnitude
                    if d < best then best, closest = d, npc end
                end
            end
        end
    end
    scan(workspace:FindFirstChild("Enemies"))
    scan(workspace:FindFirstChild("NPCs"))
    return closest
end
local function predict(part)
    if not part or not part.Parent or not SpookyAim.PredictionEnabled then
        return part and part.Position
    end
    local char = part.Parent
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or part
    local vel = hrp.AssemblyLinearVelocity or Vector3.zero
    if Vector3.new(vel.X,0,vel.Z).Magnitude <= 85 then return part.Position end
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return part.Position end
    local dist = (part.Position - myHrp.Position).Magnitude
    local lead = math.clamp(0.06 + (dist / 1200), 0.08, 0.18)
    local clamped = vel.Magnitude > 150 and vel.Unit * 150 or vel
    local pred = part.Position + clamped * lead
    if pred.X ~= pred.X then return part.Position end
    return pred
end

