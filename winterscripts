local function pvpIsStyle(t)
    if t:FindFirstChildOfClass("RemoteEvent") then return true end
    local n = t.Name:lower()
    for _, s in ipairs(PVP_STYLES) do if n:find(s) then return true end end
end
local function pvpEquipStyle()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return end
    for _, o in ipairs(char:GetChildren()) do
        if o:IsA("Tool") and pvpIsStyle(o) then return end
    end
    local bp = player:FindFirstChildOfClass("Backpack")
    if not bp then return end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and pvpIsStyle(t) then hum:EquipTool(t); task.wait(0.25); return end
    end
end
local function pvpDoM1()
    if not VirtualInputManager then return end
    local vp = camera.ViewportSize
    pcall(function() VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 0) end)
    task.wait(0.05)
    pcall(function() VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 0) end)
end
local function pvpDoSK(kc)
    if not VirtualInputManager then return end
    pcall(function() VirtualInputManager:SendKeyEvent(true, kc, false, game) end)
    task.wait(0.08)
    pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end)
end
local function pvpEnemies()
    local t = {}
    local mH = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local c = p.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                table.insert(t, { p=p, d = mH and (h.Position-mH.Position).Magnitude or 9999 })
            end
        end
    end
    table.sort(t, function(a,b) return a.d < b.d end)
    return t
end
local function pvpFurthest()
    local t = pvpEnemies()
    return #t > 0 and t[#t].p or nil
end
local function pvpGetFly()
    local c = pvpManualTarget and pvpManualTarget.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if pvpManualTarget and hum and hum.Health > 0 then return pvpManualTarget end
    return pvpFlyTarget
end
local function pvpNukeBV()
    if pvpActiveBV then pcall(function() pvpActiveBV:Destroy() end); pvpActiveBV = nil end
end
local function pvpGetBV()
    local h = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not h then return nil end
    if pvpActiveBV and pvpActiveBV.Parent == h then return pvpActiveBV end
    pvpNukeBV()
    local bv = Instance.new("BodyVelocity")
    bv.Name = "_WSFly"
    bv.MaxForce = Vector3.new(1e6,1e6,1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = h
    pvpActiveBV = bv
    return bv
end
local function pvpNC(on)
    local c = player.Character
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = not on end
    end
end
player.CharacterRemoving:Connect(pvpNukeBV)

local function isAlly(p)
    if not p or p == player then return false end
    local ok, r = pcall(function()
        local pg = player:FindFirstChild("PlayerGui")
        local main = pg and pg:FindFirstChild("Main")
        local allies = main and main:FindFirstChild("Allies")
        local container = allies and allies:FindFirstChild("Container")
        local list = container and container:FindFirstChild("Allies")
        local scroll = list and list:FindFirstChild("ScrollingFrame")
        if scroll and scroll:FindFirstChild(p.Name, true) then return true end
        return false
    end)
    return ok and r == true
end
local function isEnemy(p)
    if not p or p == player then return false end
    if isAlly(p) then return false end
    if player.Team and p.Team and player.Team.Name == "Marines" and p.Team.Name == "Marines" then return false end
    return true
end
local function isPvPOn(target)
    if not target then return false end
    local ok, on = pcall(function()
        if target:IsA("Player") and target:GetAttribute("PvpDisabled") == true then return false end
        local char = target:IsA("Player") and target.Character or target
        if char and char:GetAttribute("PvpDisabled") == true then return false end
        if char and char:FindFirstChildOfClass("ForceField") then return false end
        return true
    end)
    return ok and on == true
end
local function inSafeZone(target)
    if not target then return false end
    local ok, r = pcall(function()
        local char = target:IsA("Player") and target.Character or target
        if not char then return false end
        if char:FindFirstChildOfClass("ForceField") then return true end
        if char:GetAttribute("SafeZone") == true or char:GetAttribute("InSafeZone") == true then return true end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local function checkFolder(folder)
            if not folder then return false end
            for _, zone in ipairs(folder:GetChildren()) do
                if zone:IsA("BasePart") then
                    local lp = zone.CFrame:PointToObjectSpace(hrp.Position)
                    local h = zone.Size / 2
                    if math.abs(lp.X) <= h.X and math.abs(lp.Y) <= h.Y + 25 and math.abs(lp.Z) <= h.Z then
                        return true
                    end
                end
            end
            return false
        end
        local wo = workspace:FindFirstChild("_WorldOrigin")
        if wo and checkFolder(wo:FindFirstChild("SafeZones")) then return true end
        return false
    end)
    return ok and r == true
end
local function isBlacklisted(p)
    if not p then return false end
    local bl = _G.PlayerBlacklist
    if not bl then return false end
    if bl[p] == true then return true end
    if p.UserId and (bl[p.UserId] == true or bl[tostring(p.UserId)] == true) then return true end
    if p.Name and (bl[p.Name] == true or bl[string.lower(p.Name)] == true) then return true end
    return false
end
local function getLevel(p)
    if not p then return 0 end
    local lvl = 0
    local d = p:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then lvl = tonumber(d.Level.Value) or 0 end
    if lvl <= 0 then
        local ls = p:FindFirstChild("leaderstats")
        if ls then
            local l = ls:FindFirstChild("Level") or ls:FindFirstChild("Lvl")
            if l then lvl = tonumber(l.Value) or 0 end
        end
    end
    return lvl
end

local pvpLM1, pvpLSK, pvpSkI, pvpSkB = 0,0,1,false
RunService.Heartbeat:Connect(function()
    if not PVP.AutoKill.Enabled then return end
    local mH = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not mH then return end
    local t = pvpGetFly()
    if not t then return end
    local c = t.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not c or not hum or hum.Health <= 0 then return end
    local eH = c:FindFirstChild("HumanoidRootPart")
    if not eH then return end
    if (eH.Position - mH.Position).Magnitude > PVP.AutoKill.StopRange + 3 then return end
    pvpEquipStyle()
    local now = tick()
    if (now - pvpLM1) >= PVP.AutoKill.M1Delay then
        pvpLM1 = now
        task.spawn(pvpDoM1)
    end
    if PVP.AutoKill.UseSkills and not pvpSkB and (now - pvpLSK) >= PVP.AutoKill.SkillDelay then
        pvpLSK = now; pvpSkB = true
        local s = PVP.AutoKill.SkillKeys[pvpSkI]
        pvpSkI = (pvpSkI % #PVP.AutoKill.SkillKeys) + 1
        task.spawn(function() pvpDoSK(s); task.wait(0.5); pvpSkB = false end)
    end
end)

RunService.Heartbeat:Connect(function()
    if not PVP.AutoKill.Enabled then
        if pvpActiveBV then
            pvpActiveBV.Velocity = Vector3.zero
            pvpNukeBV()
            local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
            pvpNC(false)
        end
        return
    end
    local mH = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not mH or not hum then return end
    local t = pvpGetFly()
    local c = t and t.Character
    local eH = c and c:FindFirstChild("HumanoidRootPart")
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    pvpNC(true)
    if not eH then
        local bv = pvpGetBV()
        if bv then bv.Velocity = Vector3.zero end
        return
    end
    local dist = (eH.Position - mH.Position).Magnitude
    if dist <= PVP.AutoKill.StopRange then
        local bv = pvpGetBV()
        if bv then bv.Velocity = Vector3.zero end
        mH.CFrame = CFrame.new(mH.Position, Vector3.new(eH.Position.X, mH.Position.Y, eH.Position.Z))
        return
    end
    local bv = pvpGetBV()
    if not bv then return end
    local tp = dist > PVP.AutoKill.DiveRange
        and eH.Position + Vector3.new(0, PVP.AutoKill.HoverHeight, 0)
        or eH.Position
    bv.Velocity = bv.Velocity:Lerp((tp - mH.Position).Unit * PVP.AutoKill.Speed, PVP.AutoKill.Smooth)
    mH.CFrame = CFrame.new(mH.Position, Vector3.new(eH.Position.X, mH.Position.Y, eH.Position.Z))
end)

local function sbIsValidTarget(p)
    if not p or p == player or not p.Character then return false end
    if SpookyBounty.Checked[p] then return false end
    if not isEnemy(p) then return false end
    if not isPvPOn(p) then return false end
    if inSafeZone(p) then return false end
    if isBlacklisted(p) then return false end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then return false end
    if hrp.Position.Y > 12000 then return false end
    local lvl = getLevel(p)
    if lvl > 0 and lvl < SpookyBounty.MinLevel then return false end
